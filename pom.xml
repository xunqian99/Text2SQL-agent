<?xml version="1.0" encoding="UTF-8"?>
<!--
  版本选择依据（每个版本都在阿里云 Maven 镜像上验证过真实存在，未编造）：
    Spring Boot        3.5.16  3.x 线最新稳定版
    Spring AI          1.1.8   与 Spring Boot 3.x 配套（2.x 需要 Boot 4.x）
    JSqlParser         5.4     最新稳定版
    PostgreSQL JDBC    42.7.13 最新稳定版
  Spring AI 和 PostgreSQL 的版本由 BOM / Boot 父 POM 管理，不单独写死。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.text2sql</groupId>
  <artifactId>text2sql-agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>text2sql-agent</name>
  <description>电商订单域 Text2SQL Agent</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-ai.version>1.1.8</spring-ai.version>
    <jsqlparser.version>5.4</jsqlparser.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web 接入层：REST 接口 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JDBC + 连接池：执行 SQL 用 JdbcTemplate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- 参数校验：接口入参校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- LLM 接入（阶段 1） -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!-- SQL AST 解析与白名单校验（阶段 1） -->
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>${jsqlparser.version}</version>
    </dependency>

    <!-- PostgreSQL 驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 评估集是 YAML，需要 YAML 解析（阶段 1 评估运行器） -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        让 `mvn test` 裸跑就能通过。

        Mockito 5 默认使用 inline mock maker，它需要在运行时把 agent 自附加到
        当前 JVM。JDK 9+ 默认禁止自附加（jdk.attach.allowAttachSelf=false），
        于是所有用到 @Mock/@MockBean 的测试会一起报
        "Could not initialize plugin: interface org.mockito.plugins.MockMaker"。

        以前要在命令行手动加 -DargLine="-Djdk.attach.allowAttachSelf=true"，
        这属于「环境知识」而不是「项目知识」：换台机器、换个人跑就会踩到，
        而且报错信息完全指不到根因。把它固化在这里，让默认路径就是正确的路径。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
