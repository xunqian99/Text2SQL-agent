, filter=null, tables=[support_tickets, ticket_categories], notes=分母是**全部工单**（含未解决的）。未解决的工单算未达成。, outputRule=null, queryPattern=null, outputUnit=PERCENT, outputScale=2, requiredContextAny=[], excludedContextAny=[]],
    Metric[name=unique_buyers, aliases=[下单人数, 购买人数, 下单买家数, 独立买家数], description=下单人数 = 去重独立下单用户数（customer_unique_id）, expression=COUNT(DISTINCT c.customer_unique_id), filter=o.order_status NOT IN ('canceled', 'unavailable'), tables=[orders, customers], notes=【关键】统计「下单人数/买家数」时，必须关联 customers 表并按 c.customer_unique_id 去重，
