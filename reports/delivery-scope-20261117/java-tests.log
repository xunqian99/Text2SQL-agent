    Metric[name=sla_rate, aliases=[SLA达成率, SLA 达成率, SLA达标率, SLA 达标率, 工单达成率, SLA], description=SLA 达成率 = 解决时长不超过类目 SLA 的工单 / 全部工单, expression=ROUND(100.0 * COUNT(*) FILTER (
