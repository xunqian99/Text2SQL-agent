, outputRule=null, queryPattern=null, outputUnit=null, outputScale=null, requiredContextAny=[], excludedContextAny=[]],
    Metric[name=yoy_growth, aliases=[同比增长, 同比增长率, YoY], description=同比增长率 = (本期 - 同期) / 同期, expression=ROUND(100.0 * (m18.gmv - m17.gmv) / m17.gmv, 2), filter=o.order_status NOT IN ('canceled', 'unavailable'), tables=[orders, order_items], notes=按月对齐两个年度，缺月份的年份自然不参与（INNER JOIN）。, outputRule=依次输出月份、2017 GMV、2018 GMV、同比增长率；GMV 保留 2 位小数，同比增长率乘 100 保留 2 位小数；不要输出年度中间行。, queryPattern=WITH monthly AS (
  SELECT EXTRACT(YEAR FROM o.order_purchase_timestamp)::int AS yr,
         EXTRACT(MONTH FROM o.order_purchase_timestamp)::int AS mo,
         SUM(oi.price + oi.freight_value) AS gmv
  FROM orders o
  JOIN order_items oi ON oi.order_id = o.order_id
  WHERE o.order_status NOT IN ('canceled', 'unavailable')
  GROUP BY 1, 2
)
SELECT m18.mo,
       ROUND(m17.gmv, 2) AS gmv_2017,
       ROUND(m18.gmv, 2) AS gmv_2018,
       ROUND(100.0 * (m18.gmv - m17.gmv) / NULLIF(m17.gmv, 0), 2) AS yoy_pct
FROM monthly m18
JOIN monthly m17 ON m17.mo = m18.mo AND m17.yr = 2017
WHERE m18.yr = 2018
