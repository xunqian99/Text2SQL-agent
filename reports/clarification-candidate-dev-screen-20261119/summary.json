      "id": "T4-027",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT warehouse_id,\n       SUM(quantity) AS total_quantity,\n       ROUND(AVG(quantity)::numeric, 2) AS avg_quantity\nFROM inventory\nGROUP BY warehouse_id\nORDER BY total_quantity DESC\nLIMIT 100;"
