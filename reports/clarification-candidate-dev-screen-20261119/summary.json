      "id": "T4-021",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT c.campaign_id, COUNT(u.usage_id) AS usage_count\nFROM campaigns c\nLEFT JOIN coupons cp ON cp.campaign_id = c.campaign_id\nLEFT JOIN coupon_usages u ON u.coupon_id = cp.coupon_id\nGROUP BY c.campaign_id\nORDER BY c.campaign_id\nLIMIT 1000;"
    },
