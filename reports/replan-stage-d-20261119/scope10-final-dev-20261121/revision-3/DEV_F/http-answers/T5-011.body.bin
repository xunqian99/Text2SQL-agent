{"status":"SUCCESS","sql":"SELECT b.brand_id, ROUND(SUM(oi.price), 2) AS amount\nFROM brands b\nJOIN product_brand_map pbm ON pbm.brand_id = b.brand_id AND pbm.is_current = true\nJOIN order_items oi ON oi.product_id = pbm.product_id\nGROUP BY b.brand_id\nORDER BY amount DESC, b.brand_id ASC\nLIMIT 10;","message":null,"violations":[],"columns":["brand_id","amount"],"rows":[["51","232862.79"],["56","211781.67"],["20","202288.95"],["9","200192.86"],["32","197901.11"],["4","197577.91"],["25","191952.60"],["3","186143.51"],["39","186017.41"],["48","184732.75"]],"truncated":false,"rewritten":false,"rowCount":10,"schemaTableCount":8,"retrievedTables":["brands","order_items","orders","sellers","product_brand_map","products","refund_items","settlement_items"],"schemaDdlChars":1905,"llm":{"model":"deepseek-flash","promptTokens":2909,"completionTokens":967,"totalTokens":3876,"latencyMs":7087,"costYuan":0.00502084},"timings":{"retrievalMs":2,"generationMs":7088,"validationMs":3,"executionMs":85,"totalMs":7180},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"43b10f8a-bd03-45ec-bd09-5dec484f2957","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":7180,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":7082,"EXECUTION":85,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":3,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":6,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}