{"status":"SUCCESS","sql":"SELECT ROUND(100.0 * COUNT(DISTINCT o.order_id) FILTER (WHERE m.member_id IS NOT NULL) / NULLIF(COUNT(DISTINCT o.order_id), 0), 2) AS member_order_pct FROM orders o LEFT JOIN customers c ON c.customer_id = o.customer_id LEFT JOIN members m ON m.customer_unique_id = c.customer_unique_id WHERE o.order_status NOT IN ('canceled', 'unavailable') LIMIT 201","message":null,"violations":[],"columns":["member_order_pct"],"rows":[["100.00"]],"truncated":false,"rewritten":true,"rowCount":1,"schemaTableCount":8,"retrievedTables":["members","orders","search_logs","support_tickets","member_levels","coupon_usages","customers","member_snapshot"],"schemaDdlChars":1600,"llm":{"model":"deepseek-flash","promptTokens":4062,"completionTokens":169,"totalTokens":4231,"latencyMs":1601,"costYuan":0.00298184},"timings":{"retrievalMs":1,"generationMs":1601,"validationMs":17,"executionMs":225,"totalMs":1847},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"9750621b-f7a6-47d9-a863-cea84d843ce6","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":1847,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":1597,"EXECUTION":225,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":1,"VALIDATION":17,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":4,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":3,"currentStageMs":0}}