{"status":"SUCCESS","sql":"SELECT ROUND(COUNT(*) FILTER (WHERE order_cnt >= 2) * 100.0 / NULLIF(COUNT(*), 0), 2) AS repeat_rate FROM (SELECT c.customer_unique_id, COUNT(DISTINCT o.order_id) AS order_cnt FROM orders o JOIN customers c ON c.customer_id = o.customer_id WHERE o.order_status NOT IN ('canceled', 'unavailable') AND c.customer_unique_id IS NOT NULL GROUP BY c.customer_unique_id) t LIMIT 201","message":null,"violations":[],"columns":["repeat_rate"],"rows":[["3.04"]],"truncated":false,"rewritten":true,"rowCount":1,"schemaTableCount":8,"retrievedTables":["customers","orders","order_items","order_payments","order_reviews","coupon_usages","members","refund_items"],"schemaDdlChars":1589,"llm":{"model":"deepseek-flash","promptTokens":3755,"completionTokens":387,"totalTokens":4142,"latencyMs":2647,"costYuan":0.0035468400000000008},"timings":{"retrievalMs":2,"generationMs":2648,"validationMs":12,"executionMs":173,"totalMs":2838},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"45ce8764-498d-4542-9372-088a6ba7f079","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":2838,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":2642,"EXECUTION":173,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":12,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":6,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":3,"currentStageMs":0}}