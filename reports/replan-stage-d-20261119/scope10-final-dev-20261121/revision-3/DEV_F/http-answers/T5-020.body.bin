{"status":"SUCCESS","sql":"-- 以库存变动流水为事实表，左连接仓库与区域以保留未知大区NULL，不连接当前库存表\nSELECT r.macro_region, m.movement_type, COUNT(*) AS record_count, SUM(m.quantity) AS total_quantity\nFROM inventory_movements m\nLEFT JOIN warehouses w ON w.warehouse_id = m.warehouse_id\nLEFT JOIN regions r ON r.region_code = w.region_code\nGROUP BY r.macro_region, m.movement_type\nORDER BY r.macro_region NULLS LAST, m.movement_type\nLIMIT 100;","message":null,"violations":[],"columns":["macro_region","movement_type","record_count","total_quantity"],"rows":[["Nordeste","1","1675","83152"],["Nordeste","2","3390","167744"],["Nordeste","3","3320","169582"],["Nordeste","4","1719","86066"],["Sudeste","1","4945","251240"],["Sudeste","2","9689","490948"],["Sudeste","3","9757","489709"],["Sudeste","4","4911","245786"],["Sul","1","1639","84118"],["Sul","2","3194","158187"],["Sul","3","3342","163762"],["Sul","4","1579","79120"]],"truncated":false,"rewritten":false,"rowCount":12,"schemaTableCount":8,"retrievedTables":["inventory_movements","regions","warehouses","inventory","shipments","customers","products","sellers"],"schemaDdlChars":1887,"llm":{"model":"deepseek-flash","promptTokens":2910,"completionTokens":941,"totalTokens":3851,"latencyMs":6397,"costYuan":0.00491784},"timings":{"retrievalMs":2,"generationMs":6398,"validationMs":17,"executionMs":26,"totalMs":6445},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"d87fdd44-ce9f-4c3d-8d09-42ae157449a5","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":6445,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":6392,"EXECUTION":26,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":17,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":6,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}