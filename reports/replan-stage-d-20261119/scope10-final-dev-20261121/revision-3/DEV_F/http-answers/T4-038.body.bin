{"status":"SUCCESS","sql":"SELECT ml.level_name, COUNT(DISTINCT m.member_id) AS member_count\nFROM user_tags ut\nJOIN user_tag_map utm ON utm.tag_id = ut.tag_id\nJOIN members m ON m.member_id = utm.member_id\nJOIN member_levels ml ON ml.level_id = m.level_id\nWHERE ut.tag_code = 'CHURN_RISK'\nGROUP BY ml.level_name\nORDER BY member_count DESC\nLIMIT 100;","message":null,"violations":[],"columns":["level_name","member_count"],"rows":[["青铜会员","36143"],["白银会员","25377"],["黄金会员","4357"],["铂金会员","121"]],"truncated":false,"rewritten":false,"rowCount":4,"schemaTableCount":8,"retrievedTables":["member_levels","members","user_tag_map","user_tags","coupon_usages","customers","member_snapshot","referrals"],"schemaDdlChars":1457,"llm":{"model":"deepseek-flash","promptTokens":3570,"completionTokens":615,"totalTokens":4185,"latencyMs":4530,"costYuan":0.0027685599999999998},"timings":{"retrievalMs":2,"generationMs":4531,"validationMs":3,"executionMs":131,"totalMs":4669},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"32470532-3754-4825-9744-1f399169669d","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":4669,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":4506,"EXECUTION":131,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":3,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":25,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}