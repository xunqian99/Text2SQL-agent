{"status":"SUCCESS","sql":"SELECT c.customer_state,\n       ROUND(100.0 * COUNT(*) FILTER (WHERE r.review_score BETWEEN 1 AND 2) / COUNT(*), 2) AS low_rating_pct\nFROM order_reviews r\nJOIN orders o ON o.order_id = r.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable')\nGROUP BY c.customer_state\nORDER BY low_rating_pct DESC, c.customer_state ASC\nLIMIT 10;","message":null,"violations":[],"columns":["customer_state","low_rating_pct"],"rows":[["AL","23.79"],["RR","22.22"],["MA","21.22"],["SE","20.93"],["RJ","20.00"],["PA","19.33"],["CE","19.15"],["BA","18.27"],["PI","17.90"],["PB","16.35"]],"truncated":false,"rewritten":false,"rowCount":10,"schemaTableCount":8,"retrievedTables":["order_reviews","customers","orders","geolocation","shipping_addresses","order_items","order_payments","support_tickets"],"schemaDdlChars":1838,"llm":{"model":"deepseek-flash","promptTokens":3706,"completionTokens":842,"totalTokens":4548,"latencyMs":5625,"costYuan":0.00531784},"timings":{"retrievalMs":2,"generationMs":5626,"validationMs":13,"executionMs":208,"totalMs":5851},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"9b45bd60-0ec5-41b8-aa93-583f798346be","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":5851,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":5622,"EXECUTION":208,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":13,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":4,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}