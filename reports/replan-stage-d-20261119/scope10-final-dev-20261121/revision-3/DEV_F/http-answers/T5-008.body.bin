{"status":"SUCCESS","sql":"SELECT mr.level_id AS referrer_level_id, mi.level_id AS invitee_level_id,\n       COUNT(*) AS referral_count,\n       ROUND(SUM(rf.reward_amount), 2) AS reward_total\nFROM referrals rf\nLEFT JOIN members mr ON mr.member_id = rf.referrer_member_id\nLEFT JOIN members mi ON mi.member_id = rf.invitee_member_id\nGROUP BY 1, 2\nORDER BY referral_count DESC LIMIT 100;","message":null,"violations":[],"columns":["referrer_level_id","invitee_level_id","referral_count","reward_total"],"rows":[["1","1","1439","10680.57"],["1","2","1063","6720.06"],["2","1","979","6117.18"],["2","2","667","4625.63"],["1","3","190","1219.71"],["3","1","175","1178.90"],["2","3","123","732.58"],["3","2","122","973.47"],["3","3","19","94.80"],["4","1","5","75.21"],["1","4","4","12.96"],["4","2","4","16.55"],["2","4","3","33.97"]],"truncated":false,"rewritten":false,"rowCount":13,"schemaTableCount":8,"retrievedTables":["referrals","members","member_levels","coupon_usages","customers","member_snapshot","search_logs","support_tickets"],"schemaDdlChars":1482,"llm":{"model":"deepseek-flash","promptTokens":2943,"completionTokens":485,"totalTokens":3428,"latencyMs":3565,"costYuan":0.00312684},"timings":{"retrievalMs":2,"generationMs":3565,"validationMs":16,"executionMs":27,"totalMs":3613},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"2019b75a-6615-478a-b87e-bd7d25f2e6e6","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":3613,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":3559,"EXECUTION":27,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":16,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":6,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":3,"currentStageMs":0}}