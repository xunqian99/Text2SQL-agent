{"status":"SUCCESS","sql":"SELECT status, ROUND(AVG(track_cnt)::numeric, 2) AS avg_tracking_records\nFROM (\n  SELECT s.status, s.shipment_id, COUNT(t.tracking_id) AS track_cnt\n  FROM shipments s\n  LEFT JOIN shipment_tracking t ON t.shipment_id = s.shipment_id\n  GROUP BY s.status, s.shipment_id\n) x\nGROUP BY status\nORDER BY status\nLIMIT 100;","message":null,"violations":[],"columns":["status","avg_tracking_records"],"rows":[["1","0.00"],["2","3.00"],["3","3.00"]],"truncated":false,"rewritten":false,"rowCount":3,"schemaTableCount":4,"retrievedTables":["shipments","shipment_tracking","warehouses","orders"],"schemaDdlChars":1162,"llm":{"model":"deepseek-flash","promptTokens":2663,"completionTokens":937,"totalTokens":3600,"latencyMs":5962,"costYuan":0.00465484},"timings":{"retrievalMs":2,"generationMs":5963,"validationMs":2,"executionMs":145,"totalMs":6114},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"af558f47-0e7a-409b-a456-1687bf93d5f2","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":6114,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":5945,"EXECUTION":145,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":2,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":18,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}