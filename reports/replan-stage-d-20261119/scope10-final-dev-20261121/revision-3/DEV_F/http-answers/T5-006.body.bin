{"status":"SUCCESS","sql":"SELECT c.customer_state, m.level_id, COUNT(DISTINCT st.ticket_id) AS ticket_count\nFROM support_tickets st\nJOIN ticket_categories tc ON tc.category_id = st.category_id\nLEFT JOIN orders o ON o.order_id = st.order_id\nLEFT JOIN customers c ON c.customer_id = o.customer_id\nLEFT JOIN members m ON m.member_id = st.member_id\nWHERE tc.category_name = '物流延迟'\nGROUP BY c.customer_state, m.level_id\nORDER BY ticket_count DESC, c.customer_state ASC NULLS LAST, m.level_id ASC NULLS LAST\nLIMIT 20;","message":null,"violations":[],"columns":["customer_state","level_id","ticket_count"],"rows":[["SP","1","188"],["SP","2","134"],["RJ","1","54"],["RJ","2","49"],["RS","1","38"],["MG","1","36"],["SP","3","30"],["PR","1","24"],["MG","2","22"],["BA","1","15"],["PR","2","15"],["SC","1","15"],["ES","1","14"],["DF","1","11"],["PE","1","11"],["RS","2","11"],["BA","2","10"],["CE","1","10"],["GO","1","10"],["GO","2","9"]],"truncated":false,"rewritten":false,"rowCount":20,"schemaTableCount":8,"retrievedTables":["support_tickets","members","customers","member_levels","geolocation","orders","search_logs","shipping_addresses"],"schemaDdlChars":1833,"llm":{"model":"deepseek-flash","promptTokens":3628,"completionTokens":1765,"totalTokens":5393,"latencyMs":11870,"costYuan":0.00893184},"timings":{"retrievalMs":2,"generationMs":11871,"validationMs":33,"executionMs":315,"totalMs":12223},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"5ee056a4-6500-4c81-8267-658578fbccd2","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":12223,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"CACHE":0,"MODEL":11865,"EXECUTION":315,"SESSION":0,"CONVERSATION":0,"RETRIEVAL":2,"VALIDATION":33,"CACHE_WRITE":0,"CLARIFICATION":0,"RESULT_CHECK":0,"GENERATION":6,"ADMISSION":0},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}