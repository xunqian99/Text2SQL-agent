{"status":"SUCCESS","sql":"SELECT p.product_category_name, COUNT(DISTINCT ri.refund_id) AS refund_order_cnt\nFROM refund_items ri\nJOIN order_items oi ON oi.order_id = ri.order_id AND oi.order_item_id = ri.order_item_id\nJOIN products p ON p.product_id = oi.product_id\nWHERE p.product_category_name IS NOT NULL\nGROUP BY p.product_category_name\nORDER BY refund_order_cnt DESC, p.product_category_name ASC\nLIMIT 100;","message":null,"violations":[],"columns":["product_category_name","refund_order_cnt"],"rows":[["cama_mesa_banho","461"],["beleza_saude","424"],["esporte_lazer","389"],["informatica_acessorios","333"],["utilidades_domesticas","302"],["moveis_decoracao","292"],["relogios_presentes","274"],["automotivo","190"],["brinquedos","185"],["telefonia","181"],["cool_stuff","179"],["ferramentas_jardim","166"],["perfumaria","145"],["bebes","141"],["eletronicos","121"],["papelaria","106"],["fashion_bolsas_e_acessorios","95"],["pet_shop","84"],["malas_acessorios","63"],["moveis_escritorio","57"],["consoles_games","51"],["eletrodomesticos","35"],["instrumentos_musicais","35"],["construcao_ferramentas_construcao","29"],["eletroportateis","26"],["alimentos","25"],["livros_interesse_geral","25"],["moveis_sala","23"],["casa_construcao","19"],["market_place","18"],["casa_conforto","17"],["climatizacao","14"],["fashion_calcados","14"],["artes","13"],["audio","13"],["construcao_ferramentas_iluminacao","13"],["construcao_ferramentas_jardim","12"],["eletrodomesticos_2","12"],["alimentos_bebidas","11"],["moveis_cozinha_area_de_servico_jantar_e_jardim","11"],["artigos_de_natal","10"],["construcao_ferramentas_seguranca","10"],["livros_tecnicos","10"],["sinalizacao_e_seguranca","9"],["agro_industria_e_comercio","8"],["bebidas","8"],["fashion_roupa_masculina","8"],["industria_comercio_e_negocios","8"],["telefonia_fixa","8"],["fashion_underwear_e_moda_praia","7"],["tablets_impressao_imagem","7"],["moveis_quarto","6"],["construcao_ferramentas_ferramentas","5"],["portateis_casa_forno_e_c