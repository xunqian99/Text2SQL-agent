{"status":"SUCCESS","sql":"SELECT ml.level_name, COUNT(DISTINCT m.member_id) AS member_count\nFROM member_levels ml\nJOIN members m ON m.level_id = ml.level_id\nJOIN user_tag_map utm ON utm.member_id = m.member_id\nJOIN user_tags ut ON ut.tag_id = utm.tag_id\nWHERE ut.tag_code = 'CHURN_RISK'\nGROUP BY ml.level_id, ml.level_name\nORDER BY member_count DESC, ml.level_id ASC\nLIMIT 100;","message":null,"violations":[],"columns":["level_name","member_count"],"rows":[["青铜会员","36143"],["白银会员","25377"],["黄金会员","4357"],["铂金会员","121"]],"truncated":false,"rewritten":false,"rowCount":4,"schemaTableCount":8,"retrievedTables":["member_levels","members","user_tag_map","user_tags","coupon_usages","customers","member_snapshot","referrals"],"schemaDdlChars":1457,"llm":{"model":"deepseek-flash","promptTokens":3570,"completionTokens":980,"totalTokens":4550,"latencyMs":10189,"costYuan":0.0057338400000000005},"timings":{"retrievalMs":2,"generationMs":10190,"validationMs":3,"executionMs":150,"totalMs":10347},"sessionId":null,"rewrittenQuestion":null,"schemaReused":false,"budget":{"requestId":"c9ab7e7e-c1e2-4583-9b02-ca3e1be1434f","timeoutMs":15000,"maxModelCalls":2,"modelCalls":1,"unknownUsageCalls":0,"elapsedMs":10347,"termination":"COMPLETE","stage":"CONVERSATION","retrySkippedReason":null,"stageMs":{"RETRIEVAL":2,"CONVERSATION":0,"SESSION":0,"EXECUTION":150,"MODEL":10186,"CACHE":0,"ADMISSION":0,"GENERATION":4,"RESULT_CHECK":0,"CLARIFICATION":0,"CACHE_WRITE":0,"VALIDATION":3},"cancellationRejected":0,"timingsVersion":"request-budget-exclusive-v1","otherMs":2,"currentStageMs":0}}