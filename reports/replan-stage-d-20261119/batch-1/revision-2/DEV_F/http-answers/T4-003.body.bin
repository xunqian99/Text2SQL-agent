{"status":"SUCCESS","sql":"SELECT p.product_category_name, COUNT(DISTINCT oi.order_id) AS order_count\nFROM order_items oi\nJOIN products p ON p.product_id = oi.product_id\nJOIN orders o ON o.order_id = oi.order_id\nWHERE p.product_category_name IS NOT NULL\nGROUP BY p.product_category_name\nORDER BY order_count DESC, p.product_category_name ASC\nLIMIT 100;","message":null,"violations":[],"columns":["product_category_name","order_count"],"rows":[["cama_mesa_banho","9417"],["beleza_saude","8836"],["esporte_lazer","7720"],["informatica_acessorios","6689"],["moveis_decoracao","6449"],["utilidades_domesticas","5884"],["relogios_presentes","5624"],["telefonia","4199"],["automotivo","3897"],["brinquedos","3886"],["cool_stuff","3632"],["ferramentas_jardim","3518"],["perfumaria","3162"],["bebes","2885"],["eletronicos","2550"],["papelaria","2311"],["fashion_bolsas_e_acessorios","1864"],["pet_shop","1710"],["moveis_escritorio","1273"],["consoles_games","1062"],["malas_acessorios","1034"],["eletrodomesticos","764"],["construcao_ferramentas_construcao","748"],["eletroportateis","630"],["instrumentos_musicais","628"],["livros_interesse_geral","512"],["casa_construcao","490"],["alimentos","450"],["moveis_sala","422"],["casa_conforto","397"],["audio","350"],["bebidas","297"],["market_place","280"],["livros_tecnicos","260"],["climatizacao","253"],["moveis_cozinha_area_de_servico_jantar_e_jardim","248"],["construcao_ferramentas_iluminacao","244"],["fashion_calcados","240"],["industria_comercio_e_negocios","235"],["eletrodomesticos_2","234"],["alimentos_bebidas","227"],["telefonia_fixa","217"],["artes","202"],["construcao_ferramentas_jardim","194"],["agro_industria_e_comercio","182"],["pcs","181"],["construcao_ferramentas_seguranca","167"],["sinalizacao_e_seguranca","140"],["artigos_de_natal","128"],["fashion_underwear_e_moda_praia","121"],["fashion_roupa_masculina","112"],["construcao_ferramentas_ferramentas","97"],["moveis_quarto","95"],["tablets_impressao_imagem","79"],["portateis