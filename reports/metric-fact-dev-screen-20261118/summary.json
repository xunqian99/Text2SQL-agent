      "finalSql": "SELECT COUNT(*) AS undelivered_order_count\nFROM orders\nWHERE order_delivered_customer_date IS NULL;"
    },
    {
      "id": "T3-020",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT ROUND(COUNT(*) FILTER (WHERE o.order_delivered_customer_date IS NOT NULL AND o.order_delivered_customer_date > o.order_estimated_delivery_date)::numeric / NULLIF(COUNT(*) FILTER (WHERE o.order_delivered_customer_date IS NOT NULL), 0), 4) AS late_delivery_rate FROM orders o LIMIT 201"
    },
    {
      "id": "T6-025",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "-- 按会员是否带有 NEW_USER 标签划分新客/老客，汇总 2018 年各月含运费 GMV\nSELECT date_trunc('month', o.order_purchase_timestamp) AS month,\n       round(sum(CASE WHEN nc.customer_unique_id IS NOT NULL THEN oi.price + oi.freight_value ELSE 0 END), 2) AS new_customer_gmv,\n       round(sum(CASE WHEN nc.customer_unique_id IS NULL THEN oi.price + oi.freight_value ELSE 0 END), 2) AS old_customer_gmv\nFROM orders o\nJOIN customers c ON c.customer_id = o.customer_id\nJOIN order_items oi ON oi.order_id = o.order_id\nLEFT JOIN (\n  SELECT DISTINCT m.customer_unique_id\n  FROM user_tags t\n  JOIN user_tag_map utm ON utm.tag_id = t.tag_id\n  JOIN members m ON m.member_id = utm.member_id\n  WHERE t.tag_code = 'NEW_USER'\n) nc ON nc.customer_unique_id = c.customer_unique_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable')\n  AND o.order_purchase_timestamp >= '2018-01-01'\n  AND o.order_purchase_timestamp < '2019-01-01'\nGROUP BY 1\nORDER BY 1\nLIMIT 12;"
    }
  ],
