    {
      "id": "T3-020",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT ROUND(COUNT(*) FILTER (WHERE order_delivered_customer_date IS NOT NULL AND order_delivered_customer_date > order_estimated_delivery_date)::numeric / NULLIF(COUNT(*) FILTER (WHERE order_delivered_customer_date IS NOT NULL), 0), 4) AS late_delivery_rate FROM orders LIMIT 201"
    },
    {
      "id": "T4-021",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT ca.campaign_name, COUNT(cu.usage_id) AS usage_count\nFROM campaigns ca\nLEFT JOIN coupons cp ON cp.campaign_id = ca.campaign_id\nLEFT JOIN coupon_usages cu ON cu.coupon_id = cp.coupon_id\nGROUP BY ca.campaign_id, ca.campaign_name\nORDER BY usage_count DESC\nLIMIT 100;"
    },
    {
      "id": "T4-027",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT w.warehouse_name,\n       SUM(i.quantity) AS total_quantity,\n       ROUND(AVG(i.quantity)::numeric, 2) AS avg_quantity\nFROM inventory i\nLEFT JOIN warehouses w ON w.warehouse_id = i.warehouse_id\nGROUP BY i.warehouse_id, w.warehouse_name\nORDER BY total_quantity DESC\nLIMIT 100;"
    },
    {
      "id": "T5-006",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT\n  c.customer_state,\n  ml.level_name,\n  COUNT(*) AS ticket_count\nFROM support_tickets st\nJOIN ticket_categories tc\n  ON tc.category_id = st.category_id\nJOIN members m\n  ON m.member_id = st.member_id\nJOIN member_levels ml\n  ON ml.level_id = m.level_id\nJOIN orders o\n  ON o.order_id = st.order_id\nJOIN customers c\n  ON c.customer_id = o.customer_id\nWHERE tc.category_name = '物流延迟'\nGROUP BY\n  c.customer_state,\n  ml.level_id,\n  ml.level_name\nORDER BY ticket_count DESC\nLIMIT 20;"
    },
    {
      "id": "T5-015",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT c.customer_state, st.event_code, COUNT(DISTINCT s.shipment_id) AS shipment_count\nFROM shipment_tracking st\nJOIN shipments s ON s.shipment_id = st.shipment_id\nJOIN orders o ON o.order_id = s.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nGROUP BY c.customer_state, st.event_code\nORDER BY shipment_count DESC\nLIMIT 20;"
    },
