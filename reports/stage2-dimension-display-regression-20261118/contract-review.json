    {
      "id": "T6-013",
      "question": "优惠券带来的 GMV 和优惠金额分别是多少？用券订单的折扣率是多少？",
      "goldSql": "SELECT ROUND(SUM(oi.price + oi.freight_value), 2) AS gmv,\n       ROUND(SUM(cu.discount_amount), 2) AS discount,\n       ROUND(100.0 * SUM(cu.discount_amount) / SUM(oi.price + oi.freight_value), 2) AS discount_pct\nFROM coupon_usages cu\nJOIN orders o ON o.order_id = cu.order_id\nJOIN order_items oi ON oi.order_id = cu.order_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable');\n",
      "goldResult": [
        {
          "gmv": 1930583.35,
          "discount": 473711.6,
          "discount_pct": 24.54
        }
      ],
