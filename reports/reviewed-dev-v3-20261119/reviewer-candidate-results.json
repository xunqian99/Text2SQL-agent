    "sql": "WITH first_order AS(SELECT c.customer_unique_id,DATE_TRUNC('month',MIN(o.order_purchase_timestamp))::date AS first_month FROM orders o JOIN customers c ON c.customer_id=o.customer_id WHERE o.order_status NOT IN('canceled','unavailable') GROUP BY c.customer_unique_id),monthly AS(SELECT DATE_TRUNC('month',o.order_purchase_timestamp)::date AS month,c.customer_unique_id,SUM(oi.price+oi.freight_value) AS gmv FROM orders o JOIN customers c ON c.customer_id=o.customer_id JOIN order_items oi ON oi.order_id=o.order_id WHERE o.order_status NOT IN('canceled','unavailable') AND o.order_purchase_timestamp>=DATE '2018-01-01' AND o.order_purchase_timestamp<DATE '2019-01-01' GROUP BY 1,2),summed AS(SELECT m.month,ROUND(SUM(m.gmv) FILTER(WHERE f.first_month=m.month),2) AS new_customer_gmv,ROUND(SUM(m.gmv) FILTER(WHERE f.first_month<m.month),2) AS returning_gmv FROM monthly m JOIN first_order f ON f.customer_unique_id=m.customer_unique_id GROUP BY m.month),calendar AS(SELECT generate_series(DATE '2018-01-01',DATE '2018-12-01',INTERVAL '1 month')::date AS month) SELECT c.month,s.new_customer_gmv,s.returning_gmv FROM calendar c LEFT JOIN summed s USING(month) ORDER BY c.month LIMIT ALL",
