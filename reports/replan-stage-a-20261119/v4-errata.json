      "source": "data/benchmarks/olist-v3-candidate/T3_time_window.yaml",
      "sourceQuestionSha256": "228f5d05729c6f95577f5e39a8860cf45f7224b4d95fa8e0285c423e11a68c3b",
      "sourceGoldSqlSha256": "c5ea8a7660e50c3e52c5e9d99ce6ac10848e51bd14bc875778caa850bd77217c",
      "originalQuestion": "以全部订单最大下单日期为参考日，包含参考日的最后90个自然日内，每周的商品销售额（不含运费）分别是多少？按周起始日期排序。",
      "proposedQuestion": "以全部订单最大下单日期为参考日，包含参考日的最后90个自然日内，仅对窗口中实际有关联订单明细事实的周，按下单时间统计每周商品销售额（不含运费）。不补没有明细事实的周；只累计窗口内明细，周以周一为起始日期，按周起始日期升序。",
      "originalGoldSql": "WITH anchor AS(SELECT MAX(order_purchase_timestamp) AS mx FROM orders)\nSELECT DATE_TRUNC('week',o.order_purchase_timestamp)::date AS week_start,\n ROUND(SUM(oi.price),2) AS sales\nFROM orders o JOIN order_items oi ON oi.order_id=o.order_id CROSS JOIN anchor a\nWHERE o.order_purchase_timestamp>=a.mx::date-INTERVAL '89 days'\n AND o.order_purchase_timestamp<a.mx::date+INTERVAL '1 day'\nGROUP BY 1 ORDER BY 1;",
      "proposedGoldSql": "WITH anchor AS(SELECT MAX(order_purchase_timestamp) AS mx FROM orders)\nSELECT DATE_TRUNC('week',o.order_purchase_timestamp)::date AS week_start,\n ROUND(SUM(oi.price),2) AS sales\nFROM orders o JOIN order_items oi ON oi.order_id=o.order_id CROSS JOIN anchor a\nWHERE o.order_purchase_timestamp>=a.mx::date-INTERVAL '89 days'\n AND o.order_purchase_timestamp<a.mx::date+INTERVAL '1 day'\nGROUP BY 1 ORDER BY 1;",
      "questionChange": true,
      "goldSqlChange": false,
      "scoringMetadataRequired": true,
      "reasons": [
        "原题不能唯一决定连续周历或事实周。V4显式选择事实周；不是宣称原题本来唯一如此。首尾不完整周只累计90日窗口内部事实。"
      ],
