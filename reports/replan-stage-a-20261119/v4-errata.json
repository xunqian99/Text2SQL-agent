      "sourceGoldSqlSha256": "73593687040fd02c8aa143f9516109adc8509c073d21d2681c6f195fb30a24bd",
      "originalQuestion": "按订单客户档案所在州统计有效订单评价记录中1到2星评价占比百分数两位，每条评价等权；按比例取前10，同值按州升序，仅输出州和比例。",
      "proposedQuestion": "按订单客户档案所在州统计有效订单评价记录中1到2星评价占比百分数两位，每条评价等权；按比例取前10，同值按州升序，仅输出州和比例。",
      "originalGoldSql": "SELECT c.customer_state,\n       ROUND(100.0 * COUNT(*) FILTER (WHERE r.review_score <= 2) / COUNT(*), 2) AS low_pct\nFROM order_reviews r\nJOIN orders o ON o.order_id = r.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable')\nGROUP BY 1 ORDER BY low_pct DESC,c.customer_state ASC NULLS LAST LIMIT 10;\n",
      "proposedGoldSql": "SELECT c.customer_state,\n       ROUND(100.0 * COUNT(*) FILTER (WHERE r.review_score IN (1,2)) / COUNT(*), 2) AS low_pct\nFROM order_reviews r\nJOIN orders o ON o.order_id = r.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable')\nGROUP BY 1 ORDER BY low_pct DESC,c.customer_state ASC NULLS LAST LIMIT 10;\n",
      "questionChange": false,
      "goldSqlChange": true,
      "scoringMetadataRequired": true,
      "reasons": [
        "题面明确1到2星，<=2在DDL允许的0或负值上不等价。只改分子谓词，全部有效订单评价记录的分母、每评价等权、Top10与单位均不动。若另有经核验的1—5分数据域契约，可在第二次审查以该证据裁决；当前DDL没有CHECK约束。"
      ],
