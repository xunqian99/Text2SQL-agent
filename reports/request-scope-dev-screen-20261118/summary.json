    {
      "id": "T3-020",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT ROUND(COUNT(*) FILTER (WHERE o.order_delivered_customer_date IS NOT NULL AND o.order_delivered_customer_date > o.order_estimated_delivery_date)::numeric / NULLIF(COUNT(*) FILTER (WHERE o.order_delivered_customer_date IS NOT NULL), 0), 4) AS late_delivery_rate FROM orders o LIMIT 201"
    },
    {
      "id": "T4-021",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT c.campaign_id, COUNT(cu.usage_id) AS coupon_usage_count\nFROM campaigns c\nLEFT JOIN coupons cp ON cp.campaign_id = c.campaign_id\nLEFT JOIN coupon_usages cu ON cu.coupon_id = cp.coupon_id\nGROUP BY c.campaign_id\nLIMIT 1000;"
    },
    {
      "id": "T4-027",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT warehouse_id,\n       SUM(quantity) AS total_quantity,\n       ROUND(AVG(quantity)::NUMERIC, 2) AS avg_quantity\nFROM inventory\nGROUP BY warehouse_id\nORDER BY warehouse_id\nLIMIT 100;"
    },
    {
      "id": "T5-006",
      "status": "SUCCESS",
      "correct": true,
      "finalSql": "SELECT c.customer_state, ml.level_name, COUNT(*) AS ticket_count\nFROM support_tickets st\nJOIN ticket_categories tc ON tc.category_id = st.category_id\nJOIN orders o ON o.order_id = st.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nJOIN members m ON m.member_id = st.member_id\nJOIN member_levels ml ON ml.level_id = m.level_id\nWHERE tc.category_name = '物流延迟'\nGROUP BY c.customer_state, ml.level_id, ml.level_name\nORDER BY ticket_count DESC, c.customer_state, ml.level_name\nLIMIT 20;"
    },
    {
      "id": "T5-015",
      "status": "SUCCESS",
      "correct": false,
      "finalSql": "SELECT st.event_code, c.customer_state, COUNT(DISTINCT st.shipment_id) AS shipment_count\nFROM shipment_tracking st\nJOIN shipments s ON s.shipment_id = st.shipment_id\nJOIN orders o ON o.order_id = s.order_id\nJOIN customers c ON c.customer_id = o.customer_id\nGROUP BY st.event_code, c.customer_state\nORDER BY shipment_count DESC\nLIMIT 20;"
    },
